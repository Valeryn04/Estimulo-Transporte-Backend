# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.
# En este archivo «#» inicia un comentario: si una contraseña lo contiene, escríbala entre comillas.
NODE_ENV=development
PORT=3100
# URL pública del frontend (CORS y enlaces en correos). Pueden ser varias separadas por coma.
FRONTEND_URL=http://localhost:4300

# Base de datos PostgreSQL 15+ (en este equipo: servidor 16, puerto 5433)
DATABASE_URL=postgres://usuario:clave@localhost:5433/estimulo_transporte
# Base de datos solo para pruebas automáticas (se borra y recrea en cada ejecución; el nombre debe contener "test")
TEST_DATABASE_URL=postgres://usuario:clave@localhost:5433/estimulo_transporte_test

# Secreto de firma de JWT: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Llaves de cifrado en reposo (AES-256-GCM): id:base64(32 bytes), separadas por coma; la primera es la activa.
# Generar una: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=v1:

# Almacenamiento de documentos (carpeta fuera del código)
STORAGE_DIR=./uploads
# Conexiones máximas a PostgreSQL por instancia de la API (por defecto 20).
DB_POOL_MAX=20
# Carpeta de las herramientas de PostgreSQL (pg_dump, pg_restore) para las copias de respaldo. Vacío = usar el PATH.
PG_BIN=

# Redes del proxy de confianza (para leer la IP real). 0 = sin proxy.
TRUST_PROXY=0
# Restricción de IP del portal interno. Lista separada por comas (IP o CIDR); vacío = sin restricción.
INTERNAL_ALLOWED_IPS=

# Administrador principal inicial (solo lo lee `npm run seed:admin`). Cámbiela al ingresar por primera vez.
ADMIN_USUARIO=admin
ADMIN_NOMBRES=Administrador de la plataforma
ADMIN_CORREO=
ADMIN_PASSWORD=

# Correo (SMTP). Con estos valores (localhost:1026) y `npm run dev:smtp` los correos NO salen a ningún buzón:
# se guardan como archivos en dev-mail/. En producción use el SMTP institucional de la Alcaldía (o un proveedor
# transaccional) con SPF, DKIM y DMARC configurados sobre el dominio del remitente (RNF-13).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_SERVERNAME=
MAIL_FROM="Estímulo Social de Transporte <no-responder@example.org>"
# Secreto compartido con el proveedor de correo para el webhook de entregas y rebotes (mínimo 16 caracteres)
MAIL_WEBHOOK_SECRET=

# Brevo (SMTP transaccional): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<login SMTP de Brevo>,
# SMTP_PASS=<llave SMTP>, SMTP_TLS_SERVERNAME=smtp-relay.sendinblue.com (el certificado de Brevo se valida con ese nombre). El remitente de MAIL_FROM debe ser un remitente verificado en Brevo (con SPF/DKIM del dominio).
