{
  "name": "estimulo-transporte-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del Estímulo Social de Transporte - Alcaldía de Barranquilla",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx scripts/migrate.ts",
    "db:reiniciar": "tsx scripts/reiniciar-bd.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "dev:smtp": "tsx scripts/dev-smtp.ts",
    "demo:datos": "tsx scripts/datos-demo.ts",
    "respaldo": "tsx scripts/respaldo.ts",
    "restaurar": "tsx scripts/restaurar.ts",
    "verificar:documentos": "tsx scripts/verificar-documentos.ts",
    "prueba:carga": "tsx scripts/prueba-carga.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "eslint": "^10.12.0",
    "mailparser": "^3.9.36",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.17",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
